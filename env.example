# Diese komplette Datei ist OPTIONAL. Ohne .env (oder mit einer leeren)
# funktioniert "npm start" bzw. "docker compose up -d" trotzdem: beim
# allerersten Start werden automatisch ein Login (Username/Passwort) und
# ein Verschlüsselungs-Key generiert und in data/credentials.json
# gespeichert - die Zugangsdaten werden dabei einmalig in der Konsole
# ausgegeben. Deine Immich-URL und deinen API-Key trägst du danach bequem
# im Browser unter "Einstellungen" ein.
#
# Alles hier ist nur für Leute gedacht, die feste/eigene Werte statt der
# automatisch generierten wollen (z.B. für automatisierte Deployments).

# Falls gesetzt: Basis-URL deiner EIGENEN Immich-Instanz, ohne
# abschließenden Slash. Sonst über die Einstellungen im Browser eintragen.
OWN_IMMICH_URL=

# Falls gesetzt: feste Zugangsdaten für den Login-Dialog dieses Tools statt
# automatisch generierter. APP_PASSWORD sollte mindestens 12 zufällige
# Zeichen haben.
APP_USERNAME=
APP_PASSWORD=

# Falls gesetzt: fester Schlüssel zum Verschlüsseln des im Browser
# eingetragenen API-Keys (AES-256-GCM, 64 Hex-Zeichen). Erzeugen mit:
# openssl rand -hex 32
# Sonst wird beim ersten Start automatisch einer generiert und dauerhaft
# in data/credentials.json gespeichert.
SETTINGS_ENCRYPTION_KEY=

# Port, auf dem dieses Tool laufen soll
PORT=3050

# Optional: Wird nach jedem abgeschlossenen Import (manuell oder per Abo)
# als POST-Request aufgerufen, z.B. eine Home Assistant Webhook-URL
# (Einstellungen -> Automatisierungen -> Trigger "Webhook").
# Leer lassen, wenn nicht gewünscht.
HOME_ASSISTANT_WEBHOOK_URL=
