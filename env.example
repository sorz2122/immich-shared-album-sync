# Basis-URL deiner EIGENEN Immich-Instanz, OHNE abschließenden Slash.
# Beispiel: https://immich.meinserver.de  oder  http://192.168.178.5:2283
OWN_IMMICH_URL=https://immich.meinserver.de

# NICHT MEHR ZWINGEND NÖTIG: Der API-Key wird jetzt bequem über die
# Einstellungen in der Weboberfläche eingetragen (maskiertes Feld) und dort
# verschlüsselt gespeichert. Falls hier trotzdem einer eingetragen ist, wird
# er beim allerersten Start einmalig übernommen und verschlüsselt abgelegt -
# danach kannst du diese Zeile löschen.
OWN_IMMICH_API_KEY=

# Schlüssel, mit dem der über die Einstellungen eingetragene API-Key auf der
# Platte verschlüsselt wird (AES-256-GCM). MUSS gesetzt sein, 64 Hex-Zeichen.
# Erzeugen mit:  openssl rand -hex 32
# Gut aufbewahren - ohne diesen Wert lässt sich ein gespeicherter Key nicht
# mehr entschlüsseln (dann einfach in den Einstellungen neu eintragen).
SETTINGS_ENCRYPTION_KEY=

# Port, auf dem dieses Tool laufen soll
PORT=3050

# Optional: Wird nach jedem abgeschlossenen Import (manuell oder per Abo)
# als POST-Request aufgerufen, z.B. eine Home Assistant Webhook-URL
# (Einstellungen -> Automatisierungen -> Trigger "Webhook").
# Leer lassen, wenn nicht gewünscht.
HOME_ASSISTANT_WEBHOOK_URL=

# Zugangsdaten, mit denen sich DU an diesem Tool anmeldest (HTTP Basic Auth).
# Ohne diese Zugangsdaten kann niemand die Oberfläche oder API nutzen.
# Unbedingt auf eigene, nicht erratbare Werte setzen!
APP_USERNAME=theo
APP_PASSWORD=bitte-ein-langes-zufaelliges-passwort-setzen
